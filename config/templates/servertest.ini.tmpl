# Rendered by `pzops render-config` from environment variables at container boot.
#
# Edits you make here are KEPT across restarts by default. To regenerate this
# file from .env instead, set PZ_CONFIG_OVERWRITE=1 — that discards any edit
# made here or by an in-game admin.

PublicName=${PZ_PUBLIC_NAME:-A Zomboid Server}
PublicDescription=${PZ_PUBLIC_DESCRIPTION:-}
Public=${PZ_PUBLIC:-false}

DefaultPort=16261
UDPPort=16262
MaxPlayers=${PZ_MAX_PLAYERS:-8}
Password=${PZ_SERVER_PASSWORD:-}

RCONPort=${PZ_RCON_PORT:-27015}
RCONPassword=${PZ_RCON_PASSWORD}

# Freeze the world while empty so nothing decays with nobody watching.
PauseEmpty=${PZ_PAUSE_EMPTY:-true}

# Mod load order. Mods= holds internal mod IDs, WorkshopItems= the numeric
# Workshop IDs, and the two lists must correspond entry for entry.
Mods=${PZ_MODS:-}
WorkshopItems=${PZ_WORKSHOP_ITEMS:-}

# The server writes its own save on a timer as well; this is PZ's internal
# autosave, separate from the archive the backup sidecar makes.
SaveWorldEveryMinutes=${PZ_SAVE_EVERY_MINUTES:-15}

# Anti-cheat and safety defaults suited to a small friends-only server.
Open=true
AutoCreateUserInWhiteList=true
DisplayUserName=true
GlobalChat=true
AnnounceDeath=${PZ_ANNOUNCE_DEATH:-true}
# Rejects clients whose mod Lua differs from the server's. It is a genuine
# safety check - it stops modified Lua running and catches version drift that
# would otherwise show up as desync. But on a large mod list it also rejects
# players over a single mod the server has not re-downloaded yet.
# Set PZ_LUA_CHECKSUM=false only on a server where you trust every player, and
# understand you are trading a real mismatch warning for the ability to join.
DoLuaChecksum=${PZ_LUA_CHECKSUM:-true}
DenyLoginOnOverloadedServer=true
LogLocalChat=false

# Backups are handled by the pz-backup sidecar, which produces timestamped,
# rotated archives outside the container. PZ's own backup-on-start is left on
# as a cheap extra safety net.
BackupsOnStart=true
BackupsCount=5
