# Copy to .env and edit. .env is gitignored — real passwords never enter git.
#   cp .env.example .env

# ── Identity ────────────────────────────────────────────────────────────────
# Internal name. Also names the save folder, so changing it later starts a NEW
# world rather than renaming the old one.
PZ_SERVER_NAME=servertest
PZ_PUBLIC_NAME=A Zomboid Server
PZ_PUBLIC_DESCRIPTION=

# ── Access ──────────────────────────────────────────────────────────────────
# Required. The server blocks on an interactive prompt at first boot without it.
PZ_ADMIN_USERNAME=admin
PZ_ADMIN_PASSWORD=change-me-admin

# Required. Also used by the backup sidecar to announce in chat.
# Generate one:  openssl rand -hex 16
PZ_RCON_PASSWORD=change-me-rcon
PZ_RCON_PORT=27015

# Join password for players. Empty = anyone who can reach the port can join.
PZ_SERVER_PASSWORD=
PZ_MAX_PLAYERS=8

# false keeps the server off the public browser — friends connect by IP.
PZ_PUBLIC=false

# Freeze the world while nobody is online, so nothing rots or spawns unwatched.
PZ_PAUSE_EMPTY=true

# ── Networking ──────────────────────────────────────────────────────────────
# Forward both UDP ports on your router to this host.
PZ_PORT=16261
PZ_PORT_DIRECT=16262

# ── Mods ────────────────────────────────────────────────────────────────────
# Order matters and the two lists must correspond.
# PZ_MODS=Mod ID A;Mod ID B          (the mod's internal ID)
# PZ_WORKSHOP_ITEMS=2822286426;28...  (the Workshop numeric ID)
PZ_MODS=
PZ_WORKSHOP_ITEMS=

# ── Resources ───────────────────────────────────────────────────────────────
# Raise for heavily modded servers; the JVM will use what you give it.
PZ_MEMORY_LIMIT=8g
TZ=Europe/London

# Match your host user so files on the volume are editable without sudo.
# Find yours with:  id -u && id -g
PUID=1000
PGID=1000

# ── Backups ─────────────────────────────────────────────────────────────────
BACKUP_INTERVAL_MINUTES=60
# 24 hourly archives = one rolling day of restore points.
BACKUP_KEEP_LOCAL=24
BACKUP_PREFIX=pzsave
# Announce "World backed up" in game chat.
BACKUP_ANNOUNCE=true

# ── Off-box backups (optional, off by default) ──────────────────────────────
# Local archives sit on the same disk as the server, so they survive a bad mod
# update but not a dead drive. Enable this to push them somewhere else.
#   1. rclone config        (creates ./rclone/rclone.conf)
#   2. set the two values below
BACKUP_CLOUD_ENABLED=false
BACKUP_CLOUD_REMOTE=
# Remote copies to keep. 168 hourly = 7 days.
BACKUP_CLOUD_KEEP=168
RCLONE_CONFIG_DIR=./rclone

# ── Advanced ────────────────────────────────────────────────────────────────
# 1 = re-render the config from this file on every boot, discarding hand edits.
PZ_CONFIG_OVERWRITE=0
# 1 = skip the SteamCMD update (faster restarts while debugging).
PZ_SKIP_UPDATE=0
# Steam branch for the server build. Empty = stable/default.
# Set this if your mod collection requires a beta build.
PZ_STEAM_BRANCH=
PZ_STEAM_BRANCH_PASSWORD=
PZ_EXTRA_ARGS=
